to reload the things you've done before
```{r}
load_and_rename <- function(file, suffix, envir = .GlobalEnv) {
  tmp <- new.env(parent = emptyenv()) #load into a new environment, not global
  obj_names <- load(paste0("RData/",file, ".RData"), envir = tmp) 
  
  #rename each of these objects and load them into the global environment
  for (nm in obj_names) {
    new_name <- paste0(nm, ".", suffix)
    assign(new_name, tmp[[nm]], envir = envir)
  }
  
  #hide the original object names
  #invisible(obj_names)
  
}

