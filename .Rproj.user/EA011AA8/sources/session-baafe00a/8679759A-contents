Load in all results to cross compare
```{r}
all.results <- NULL
all.class <- NULL
for(i in 1:length(df$Rdata)){
  load(paste0("RData/",df$Rdata[i], ".Rdata"))
  all.results <- rbind(all.results, 
                       data.frame(results) %>% 
                         mutate(Sample = df$Rdata[i],
                                Species = df$Species[i]))
  all.class <- rbind(all.class, 
                       data.frame(cls$Matrix, Type = cls$Type) %>% 
                         mutate(Sample = df$Rdata[i],
                                Species = df$Species[i]))
}


```


