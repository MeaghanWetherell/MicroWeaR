```{r eval=FALSE}
path <- "4 - JODA Ekg Bone/Wetherell_010626_4_SE_6.tif"
shortpath <- "JEkg.bone.6"
size.var <- 10


img <- scale_Ico( class.Ico(path),  delay = 3) #opens a window, asks to scale
wa <- Warea.Ico(img) #in that window, we now have to select our working area. then select the ticky box for whichever centroid size box you want.
tracix <- samp.traces(wa, sounds = TRUE, delay = 2) #when you want to be done, don't go next. go stop. Double click it if you have to. This is the same thing as "big matrix"
cls <- autom_class(tracix, img) #classifies traces
scr <- cross.parallel(big_matrix = tracix,
                      working.area.ico = wa$image,
                      Type = cls$Type)

results <- output.Ico(big_matrix = tracix, cls$Type, scr, wa)
save(img, wa,tracix, cls,  scr, results, file = paste0("RData/", shortpath, ".RData"))

canc_plot(wa, big_matrix = tracix, Type = cls$Type)
```


